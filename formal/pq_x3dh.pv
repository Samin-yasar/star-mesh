(*
 * pq_x3dh.pv — Symbolic model of the Star-Mesh PQ-X3DH handshake
 *
 * Reference: paper.tex §3.3 (Bundle), §3.4 (Handshake),
 *            §5.1 (bundle authenticity / initiator authentication),
 *            §5.2 (post-quantum forward secrecy)
 *            (definition / assumption numbers intentionally omitted: re-sync with paper)
 *
 * Tool:    ProVerif 2.04+   Run: proverif pq_x3dh.pv
 *
 * ── Design decisions ──────────────────────────────────────────────────────
 *
 * D1. `pub` is fully attacker-writable.  Bundle authenticity comes from the
 *     ML-DSA signature alone; no DHT/Sybil assumption is made.
 *
 * D2. ML-KEM is an IND-CCA2 black box (Bhargavan–Blanchet–Kobeissi, "Verified
 *     Models and Reference Implementations for the TLS 1.3 Standard
 *     Candidate", IEEE S&P 2017 — please double-check this citation).
 *     kem_dec fails on malformed ciphertexts; real ML-KEM uses implicit
 *     rejection (known, minor gap).
 *
 * D3. HKDF is modelled by uninterpreted, domain-separated symbols
 *     (hkdf_hs_rk, hkdf_hs_ck, hkdf_hs_conf).  K_conf is NOT the same
 *     symbol as RK.
 *
 * D4. QUANTUM ADVERSARY.  The destructor `dlog` is a public function symbol,
 *     so the attacker can compute any X25519 secret from its public key
 *     (a CRQC available for the whole run — stronger than
 *     harvest-now-decrypt-later).  ML-DSA and ML-KEM remain unbroken.
 *     Hence all classical DH secrets are known to the attacker and the
 *     session key is protected ONLY by the KEM shared secrets.
 *
 * D5. PHASES.  Phase 0 = sessions run.  Phase 1 = later compromise:
 *     the attacker receives spkSkB, pqSpkSkB, ikDhSkA, ikDhSkB.
 *     The per-session one-time keys otpkSkB / pqOtpkSkB are generated with
 *     `new` inside every Bob session and are NEVER output (this is how OTPK
 *     single-use + erasure is modelled; it is no longer a comment).
 *     PQ-FS therefore rests on ssPQ2 alone.
 *
 * NOT MODELLED (known gaps): ML-DSA key compromise / KCI, tag_B / Bob's
 * confirmation back to Alice, pre-key rotation, a no-OTPK variant.
 *
 * ── Expected results ──────────────────────────────────────────────────────
 *   Q1  attacker(sess_key_witness) phase 1        : false
 *   Q2  AliceUsedBundle(..) ==> BobPublished(..)  : true   (bundle authenticity)
 *   Q3  inj BobAcceptedM0(..) ==> inj AliceSentM0(..) : true (initiator auth)
 *  Mutations (run_mutations.sh) — each must flip as stated:
 *   nokem    : Q1 becomes TRUE   (sanity: KEM is what protects the key)
 *   nosigma0 : Q3 becomes FALSE  (sanity: sigma_0 is what binds the DH key)
 *)

(* ═══ §1 TYPES ═══ *)
type dhSk.
type dhPk.
type kemSk.
type kemPk.
type kemSeed.
type kemCt.
type dsaSk.
type dsaPk.

(* ═══ §2 CHANNELS ═══ *)
free pub: channel.
free zero: bitstring.   (* used only by the `nokem` mutant *)

(* ═══ §3 X25519 + CRQC ═══ *)
fun dh_pk(dhSk): dhPk.
fun dh(dhSk, dhPk): bitstring.
equation forall a: dhSk, b: dhSk;
    dh(a, dh_pk(b)) = dh(b, dh_pk(a)).

(* CRQC: discrete log of any public key (all function symbols are attacker-usable) *)
reduc forall x: dhSk; dlog(dh_pk(x)) = x.

(* ═══ §4 ML-KEM-768 (IND-CCA2 axiomatisation) ═══ *)
fun kem_pk(kemSk): kemPk.
fun kem_enc_ct(kemPk, kemSeed): kemCt.
fun kem_enc_ss(kemSeed): bitstring.
reduc forall sk: kemSk, seed: kemSeed;
    kem_dec(sk, kem_enc_ct(kem_pk(sk), seed)) = kem_enc_ss(seed).

(* ═══ §5 HKDF (uninterpreted, domain-separated) ═══ *)
fun hkdf_hs_rk(bitstring, bitstring): bitstring.
fun hkdf_hs_ck(bitstring, bitstring): bitstring.
fun hkdf_hs_conf(bitstring, bitstring): bitstring.   (* K_conf, own symbol *)
fun hmac_confirm(bitstring, bitstring): bitstring.

(* ═══ §6 ML-DSA-65 ═══ *)
fun dsa_pk(dsaSk): dsaPk.
fun sign(dsaSk, bitstring): bitstring.
reduc forall sk: dsaSk, m: bitstring;
    verify(dsa_pk(sk), sign(sk, m)) = m.

(* ═══ §7 AEAD ═══ *)
fun aead_enc(bitstring, bitstring): bitstring.
reduc forall k: bitstring, m: bitstring;
    aead_dec(k, aead_enc(k, m)) = m.

(* ═══ §8 ENCODING HELPERS ═══ *)
fun cat2(bitstring, bitstring): bitstring [data].
fun cat4(bitstring, bitstring, bitstring, bitstring): bitstring [data].
fun dhPk2b(dhPk):   bitstring [typeConverter].
fun kemPk2b(kemPk): bitstring [typeConverter].
fun kemCt2b(kemCt): bitstring [typeConverter].
fun dsaPk2b(dsaPk): bitstring [typeConverter].

const lblM0: bitstring.   (* "StarMesh-M0" domain label *)

fun bundlePayload(dsaPk, dhPk, dhPk, dhPk, kemPk, kemPk): bitstring [data].
fun dhtKey(dsaPk): bitstring [data].
fun mkBundle(dsaPk, dhPk, dhPk, dhPk, kemPk, kemPk, bitstring): bitstring [data].
fun mkM0(dsaPk, dhPk, dhPk, kemCt, kemCt, bitstring, bitstring): bitstring [data].

(* ═══ §9 SECRECY WITNESS ═══ *)
free sess_key_witness: bitstring [private].

(* ═══ §10 EVENTS ═══ *)
(* Bob published: (bob_id, SPK, OTPK, PQ_SPK, PQ_OTPK) *)
event BobPublished(dsaPk, dhPk, dhPk, kemPk, kemPk).
(* Alice accepted a bundle: same fields — exact pre-keys, not only the identity *)
event AliceUsedBundle(dsaPk, dhPk, dhPk, kemPk, kemPk).
(* (alice_id, bob_id, IK^DH_A, EK_A, ct1, ct2) — full transcript data *)
event AliceSentM0(dsaPk, dsaPk, dhPk, dhPk, kemCt, kemCt).
event BobAcceptedM0(dsaPk, dsaPk, dhPk, dhPk, kemCt, kemCt).

(* ═══ §11 QUERIES ═══ *)

(* Q1 — PQ-FS against a CRQC with later compromise (D4, D5).
   Everything classical is known; spk/pqSpk/ik leaked in phase 1;
   only ssPQ2 (from the never-leaked per-session PQ_OTPK) protects the key. *)
query attacker(sess_key_witness) phase 1.

(* Q2 — BUNDLE AUTHENTICITY (not session authentication):
   every bundle Alice accepts was published by Bob with exactly these pre-keys. *)
query b: dsaPk, s: dhPk, o: dhPk, p: kemPk, q: kemPk;
    event(AliceUsedBundle(b, s, o, p, q)) ==> event(BobPublished(b, s, o, p, q)).

(* Q3 — INITIATOR AUTHENTICATION with transcript data, injective.
   Fails if the sigma_0 check is removed (nosigma0 mutant). *)
query a: dsaPk, b: dsaPk, ik: dhPk, ek: dhPk, c1: kemCt, c2: kemCt;
    inj-event(BobAcceptedM0(a, b, ik, ek, c1, c2))
      ==> inj-event(AliceSentM0(a, b, ik, ek, c1, c2)).

(* ═══ §12 ALICE ═══ *)
let Alice(ikDhSkA: dhSk, ikDsaSkA: dsaSk, ikDsaPkB: dsaPk) =
    in(pub, (lookup_key: bitstring, raw_bundle: bitstring));
    let mkBundle(=ikDsaPkB, ikDhPkB, spkPkB, otpkPkB, pqSpkPkB, pqOtpkPkB, sigB) = raw_bundle in
    if lookup_key = dhtKey(ikDsaPkB) then
    let claimed_payload = bundlePayload(ikDsaPkB, ikDhPkB, spkPkB, otpkPkB,
                                        pqSpkPkB, pqOtpkPkB) in
    let (=claimed_payload) = verify(ikDsaPkB, sigB) in
    event AliceUsedBundle(ikDsaPkB, spkPkB, otpkPkB, pqSpkPkB, pqOtpkPkB);

    new ekSkA: dhSk;
    let dh1 = dh(ikDhSkA, spkPkB)  in
    let dh2 = dh(ekSkA,   ikDhPkB) in
    let dh3 = dh(ekSkA,   spkPkB)  in
    let dh4 = dh(ekSkA,   otpkPkB) in
    let ss_cl = cat4(dh1, dh2, dh3, dh4) in

    new seed1: kemSeed;
    new seed2: kemSeed;
    let ct1   = kem_enc_ct(pqSpkPkB,  seed1) in
    let ssPQ1 = kem_enc_ss(seed1) in   (*@M:pqA1*)
    let ct2   = kem_enc_ct(pqOtpkPkB, seed2) in
    let ssPQ2 = kem_enc_ss(seed2) in   (*@M:pqA2*)

    let ad = cat2(dsaPk2b(dsa_pk(ikDsaSkA)), dsaPk2b(ikDsaPkB)) in
    let info = cat4(ad, dhPk2b(dh_pk(ekSkA)), kemCt2b(ct1), kemCt2b(ct2)) in
    let ss_hybrid = cat4(ss_cl, ssPQ1, ssPQ2, ad) in
    let rk    = hkdf_hs_rk(ss_hybrid, info) in
    let kconf = hkdf_hs_conf(ss_hybrid, info) in

    let m0core = cat4(dhPk2b(dh_pk(ikDhSkA)), dhPk2b(dh_pk(ekSkA)),
                      kemCt2b(ct1), kemCt2b(ct2)) in
    (* tag_A covers M0^core (not info) *)
    let tagA = hmac_confirm(kconf, m0core) in
    (* sigma_0: domain label + Bob identity + pre-key identifiers + core + tag *)
    let sigPayload = cat2(cat4(lblM0, dsaPk2b(ikDsaPkB), kemPk2b(pqOtpkPkB), dhPk2b(otpkPkB)),
                          cat2(m0core, tagA)) in
    let sigma0 = sign(ikDsaSkA, sigPayload) in

    event AliceSentM0(dsa_pk(ikDsaSkA), ikDsaPkB, dh_pk(ikDhSkA), dh_pk(ekSkA), ct1, ct2);
    out(pub, mkM0(dsa_pk(ikDsaSkA), dh_pk(ikDhSkA), dh_pk(ekSkA), ct1, ct2, tagA, sigma0));
    out(pub, aead_enc(rk, sess_key_witness)).

(* ═══ §13 BOB ═══ *)
let Bob(ikDhSkB: dhSk, ikDsaSkB: dsaSk,
        spkSkB: dhSk, pqSpkSkB: kemSk,
        ikDsaPkA: dsaPk) =
    (* One-time keys are fresh per session and never output: single use + erasure *)
    new otpkSkB: dhSk;
    new pqOtpkSkB: kemSk;
    let spkPkB    = dh_pk(spkSkB) in
    let otpkPkB   = dh_pk(otpkSkB) in
    let pqSpkPkB  = kem_pk(pqSpkSkB) in
    let pqOtpkPkB = kem_pk(pqOtpkSkB) in
    let payload_B = bundlePayload(dsa_pk(ikDsaSkB), dh_pk(ikDhSkB),
                                  spkPkB, otpkPkB, pqSpkPkB, pqOtpkPkB) in
    let sigB = sign(ikDsaSkB, payload_B) in
    event BobPublished(dsa_pk(ikDsaSkB), spkPkB, otpkPkB, pqSpkPkB, pqOtpkPkB);
    out(pub, (dhtKey(dsa_pk(ikDsaSkB)),
              mkBundle(dsa_pk(ikDsaSkB), dh_pk(ikDhSkB),
                       spkPkB, otpkPkB, pqSpkPkB, pqOtpkPkB, sigB)));

    in(pub, raw_m0: bitstring);
    let mkM0(=ikDsaPkA, ikDhPkA, ekPkA, ct1, ct2, tagA, sigma0) = raw_m0 in
    let m0core = cat4(dhPk2b(ikDhPkA), dhPk2b(ekPkA), kemCt2b(ct1), kemCt2b(ct2)) in
    let sigPayload = cat2(cat4(lblM0, dsaPk2b(dsa_pk(ikDsaSkB)), kemPk2b(pqOtpkPkB), dhPk2b(otpkPkB)),
                          cat2(m0core, tagA)) in
    let (=sigPayload) = verify(ikDsaPkA, sigma0) in   (*@M:sigma0check*)

    let dh1 = dh(spkSkB,  ikDhPkA) in
    let dh2 = dh(ikDhSkB, ekPkA)   in
    let dh3 = dh(spkSkB,  ekPkA)   in
    let dh4 = dh(otpkSkB, ekPkA)   in
    let ss_cl = cat4(dh1, dh2, dh3, dh4) in
    let ssPQ1 = kem_dec(pqSpkSkB,  ct1) in   (*@M:pqB1*)
    let ssPQ2 = kem_dec(pqOtpkSkB, ct2) in   (*@M:pqB2*)

    let ad = cat2(dsaPk2b(ikDsaPkA), dsaPk2b(dsa_pk(ikDsaSkB))) in
    let info = cat4(ad, dhPk2b(ekPkA), kemCt2b(ct1), kemCt2b(ct2)) in
    let ss_hybrid = cat4(ss_cl, ssPQ1, ssPQ2, ad) in
    let rk    = hkdf_hs_rk(ss_hybrid, info) in
    let kconf = hkdf_hs_conf(ss_hybrid, info) in
    let (=tagA) = hmac_confirm(kconf, m0core) in
    event BobAcceptedM0(ikDsaPkA, dsa_pk(ikDsaSkB), ikDhPkA, ekPkA, ct1, ct2);

    in(pub, first_msg: bitstring);
    let (=sess_key_witness) = aead_dec(rk, first_msg) in
    0.

(* ═══ §14 PHASE-1 COMPROMISE (later reveal) ═══ *)
(* Reveals semi-static and identity DH keys plus the semi-static PQ key.
   pqOtpkSkB / otpkSkB are per-session `new` values and are never revealed. *)
let Phase1Reveal(spkSkB: dhSk, pqSpkSkB: kemSk, ikDhSkA: dhSk, ikDhSkB: dhSk) =
    phase 1;
    out(pub, (spkSkB, pqSpkSkB, ikDhSkA, ikDhSkB)).

(* ═══ §15 MAIN ═══ *)
process
    new ikDhSkA:  dhSk;
    new ikDsaSkA: dsaSk;
    new ikDhSkB:  dhSk;
    new ikDsaSkB: dsaSk;
    new spkSkB:   dhSk;
    new pqSpkSkB: kemSk;
    out(pub, (dsa_pk(ikDsaSkA), dh_pk(ikDhSkA)));
    out(pub, (dsa_pk(ikDsaSkB), dh_pk(ikDhSkB)));
    !(Alice(ikDhSkA, ikDsaSkA, dsa_pk(ikDsaSkB)))
  | !(Bob(ikDhSkB, ikDsaSkB, spkSkB, pqSpkSkB, dsa_pk(ikDsaSkA)))
  | Phase1Reveal(spkSkB, pqSpkSkB, ikDhSkA, ikDhSkB)
