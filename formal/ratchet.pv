(*
 * ratchet.pv — Symbolic model of ONE Star-Mesh PQ ratchet step after a state compromise
 *
 * Reference: paper.tex §3.5 (PQ ratchet step), §5.3 (healing)
 *
 * Tool: ProVerif 2.04+    Run: proverif ratchet.pv
 *
 * ── What this IS ──────────────────────────────────────────────────────────
 * Alice and Bob are separate processes that communicate ONLY via the
 * attacker-controlled channel `pub`.  The attacker can inject, replay,
 * drop and reorder.  Before the step, the attacker is handed the full
 * shared state (RK, EP, current chain key, and a stale PQ secret key).
 * Healing = one signed ML-KEM exchange:
 *      Alice -> Bob : (epoch, pk_A, Sig_A(lbl, epoch, kem_id, pk_A))
 *      Bob -> Alice : (ct,  Sig_B(lbl, epoch, kem_id, pk_A, ct))
 *      PRK = Extract(salt = SS_PQ, ikm = (RK, EP)); EP', RK', CK expanded
 *      from PRK with info = kem_id || ct (separate symbols per output).
 * Alice -> Bob uses a message key from CK; Bob -> Alice uses a key derived
 * from (RK', EP'), so root-key and entropy-pool secrecy are exercised.
 *
 * ── What this is NOT (known gaps, stated deliberately) ────────────────────
 *  - Not a full ratchet: no DH ratchet, no two chains, single epoch, single session.
 *  - Skipped-message-key cache: NOT proved.  "Keys cached before t_rec stay
 *    compromised" is an ASSUMPTION recorded in the README, not a query here.
 *  - No staged commit / retry / concurrency; replay is covered only for the
 *    stale-proposal case via the epoch field.
 *  - Signing keys are never compromised.
 *
 * ── Expected results (main file) ──────────────────────────────────────────
 *   Q1 attacker(w_pre_comp)        false  (pre-compromise message, one-way KDF)
 *   Q2 attacker(w_post_heal)       false  (A->B after healing)
 *   Q3 attacker(w_post_heal_B)     false  (B->A, under key from RK', EP')
 *   Q4 BobReceivedPostHeal(m)  ==> AliceSentPostHeal(m)      true
 *   Q5 AliceReceivedPostHeal(m) ==> BobSentPostHeal(m)       true
 * ── Mutants (run_mutations.sh) — each must show an attack ─────────────────
 *   unsigned : Q2/Q3/Q4/Q5 fail (active MITM on unsigned update)
 *   nostale  : Q3 fails (replay of old signed proposal; leaked old pq_sk)
 *   rng      : Q2/Q3 fail (seed_pq leaked: RNG compromise at heal time)
 *)

type kemSk.
type kemPk.
type kemSeed.
type kemCt.
type dsaSk.
type dsaPk.

free pub: channel.

(* ML-KEM-768 IND-CCA2 axiomatisation *)
fun kem_pk(kemSk): kemPk.
fun kem_enc_ct(kemPk, kemSeed): kemCt.
fun kem_enc_ss(kemSeed): bitstring.
reduc forall sk: kemSk, seed: kemSeed;
    kem_dec(sk, kem_enc_ct(kem_pk(sk), seed)) = kem_enc_ss(seed).

(* ML-DSA-65 *)
fun dsa_pk(dsaSk): dsaPk.
fun sign(dsaSk, bitstring): bitstring.
reduc forall sk: dsaSk, m: bitstring;
    verify(dsa_pk(sk), sign(sk, m)) = m.

(* Symmetric ratchet KDF *)
fun blake3_mk(bitstring): bitstring.
fun blake3_ck(bitstring): bitstring.

(* PQ root KDF: one extract (salt = SS_PQ, ikm = (RK, EP)), three expands *)
fun hkdf_pq_extract(bitstring, bitstring): bitstring.
fun hkdf_pq_ep(bitstring, bitstring): bitstring.
fun hkdf_pq_rk(bitstring, bitstring): bitstring.
fun hkdf_pq_ck(bitstring, bitstring): bitstring.

(* AEAD *)
fun aead_enc(bitstring, bitstring): bitstring.
reduc forall k: bitstring, m: bitstring;
    aead_dec(k, aead_enc(k, m)) = m.

fun cat2(bitstring, bitstring): bitstring [data].
fun cat4(bitstring, bitstring, bitstring, bitstring): bitstring [data].
fun kemPk2b(kemPk): bitstring [typeConverter].
fun kemCt2b(kemCt): bitstring [typeConverter].

(* Wire formats and constants *)
fun mkProp(bitstring, kemPk, bitstring): bitstring [data].   (* epoch, pk, sig *)
fun mkResp(kemCt, bitstring): bitstring [data].              (* ct, sig *)
const lblProp: bitstring.
const lblResp: bitstring.
const kem_id:  bitstring.   (* algorithm identifier, bound into signatures and KDF info *)
const epoch0:  bitstring.   (* the stale epoch *)
const epoch1:  bitstring.   (* the healing epoch *)

(* Secrecy witnesses *)
free w_pre_comp:    bitstring [private].
free w_post_heal:   bitstring [private].   (* A -> B *)
free w_post_heal_B: bitstring [private].   (* B -> A *)

event AliceSentPostHeal(bitstring).
event BobReceivedPostHeal(bitstring).
event BobSentPostHeal(bitstring).
event AliceReceivedPostHeal(bitstring).

query attacker(w_pre_comp).
query attacker(w_post_heal).
query attacker(w_post_heal_B).
query m: bitstring; event(BobReceivedPostHeal(m)) ==> event(AliceSentPostHeal(m)).
query m: bitstring; event(AliceReceivedPostHeal(m)) ==> event(BobSentPostHeal(m)).

(* ═══ ALICE: proposes a fresh ML-KEM key, completes the step ═══ *)
let Alice(rk0: bitstring, ep0: bitstring, sigSkA: dsaSk, sigPkB: dsaPk) =
    new pq_sk_A: kemSk;
    let pq_pk_A = kem_pk(pq_sk_A) in
    out(pub, mkProp(epoch1, pq_pk_A,
        sign(sigSkA, cat4(lblProp, epoch1, kemPk2b(pq_pk_A), kem_id))));

    in(pub, rawResp: bitstring);
    let mkResp(ctR, sigR) = rawResp in
    let (=cat2(cat4(lblResp, epoch1, kemPk2b(pq_pk_A), kem_id), kemCt2b(ctR))) = verify(sigPkB, sigR) in   (*@M:aliceverify*)
    let ss_A  = kem_dec(pq_sk_A, ctR) in
    let prk_A = hkdf_pq_extract(ss_A, cat2(rk0, ep0)) in
    let info_A = cat2(kem_id, kemCt2b(ctR)) in
    let ep_A  = hkdf_pq_ep(prk_A, info_A) in
    let rk_A  = hkdf_pq_rk(prk_A, info_A) in
    let ck_A  = hkdf_pq_ck(prk_A, info_A) in

    (* A -> B: secrecy witness + fresh per-message value for authenticity *)
    new m_a: bitstring;
    event AliceSentPostHeal(m_a);
    out(pub, aead_enc(blake3_mk(ck_A), cat2(w_post_heal, m_a)));

    (* B -> A: key derived from healed RK' and EP' *)
    in(pub, cB: bitstring);
    let cat2(wB, m_b) = aead_dec(blake3_mk(cat2(rk_A, ep_A)), cB) in
    event AliceReceivedPostHeal(m_b).

(* ═══ BOB: accepts a proposal, encapsulates, completes the step ═══ *)
let Bob(rk0: bitstring, ep0: bitstring, sigSkB: dsaSk, sigPkA: dsaPk) =
    in(pub, rawProp: bitstring);
    let mkProp(epochP, pkP, sigP) = rawProp in
    let (=cat4(lblProp, epochP, kemPk2b(pkP), kem_id)) = verify(sigPkA, sigP) in   (*@M:bobverify*)
    if epochP = epoch1 then   (*@M:epoch*)
    new seed_pq: kemSeed;
    (*@M:rng_insert*)
    let ct = kem_enc_ct(pkP, seed_pq) in
    let ss_B = kem_enc_ss(seed_pq) in
    out(pub, mkResp(ct, sign(sigSkB, cat2(cat4(lblResp, epochP, kemPk2b(pkP), kem_id), kemCt2b(ct)))));

    let prk_B  = hkdf_pq_extract(ss_B, cat2(rk0, ep0)) in
    let info_B = cat2(kem_id, kemCt2b(ct)) in
    let ep_B   = hkdf_pq_ep(prk_B, info_B) in
    let rk_B   = hkdf_pq_rk(prk_B, info_B) in
    let ck_B   = hkdf_pq_ck(prk_B, info_B) in

    new m_b: bitstring;
    event BobSentPostHeal(m_b);
    out(pub, aead_enc(blake3_mk(cat2(rk_B, ep_B)), cat2(w_post_heal_B, m_b)));

    in(pub, cA: bitstring);
    let cat2(wA, m_a) = aead_dec(blake3_mk(ck_B), cA) in
    event BobReceivedPostHeal(m_a).

(* ═══ MAIN: pre-compromise message, state reveal, then the healing step ═══ *)
process
    new rk0: bitstring;
    new ep0: bitstring;
    new ck0: bitstring;
    new sigSkA: dsaSk;
    new sigSkB: dsaSk;
    out(pub, (dsa_pk(sigSkA), dsa_pk(sigSkB)));

    (* Epoch 0: message key mk0 is used once; chain advances; mk0, ck0 are erased *)
    let mk0 = blake3_mk(ck0) in
    let ck1 = blake3_ck(ck0) in
    out(pub, aead_enc(mk0, w_pre_comp));

    (* A genuine proposal signed BEFORE the compromise, whose secret key is part of the state *)
    new pq_sk_old: kemSk;
    out(pub, mkProp(epoch0, kem_pk(pq_sk_old),
        sign(sigSkA, cat4(lblProp, epoch0, kemPk2b(kem_pk(pq_sk_old)), kem_id))));

    (* t_comp: attacker learns the entire session state (never mk0 or ck0) *)
    out(pub, (rk0, ep0, ck1, pq_sk_old));

    (* t_rec: clean RNG, signing keys intact; one healing round trip *)
    ( Alice(rk0, ep0, sigSkA, dsa_pk(sigSkB))
    | Bob(rk0, ep0, sigSkB, dsa_pk(sigSkA)) )
